# Server
PORT=
NODE_ENV=
LOG_LEVEL=

# MongoDB (local)
MONGODB_URI=

# Local workspace owned by the Node worker (not the browser)
WORKSPACE_ROOT=

# Optional override for Simplicity Commander (else use Mongo settings / defaults JSON)
COMMANDER_PATH=

# CORS for local React Vite/CRA
CORS_ORIGIN=

# Default VCOM capture (seconds) if not set per-run
DEFAULT_CAPTURE_TIMEOUT_SECONDS=

# Flash behavior overrides (optional; prefer Mongo SystemSettings)
FLASH_RETRY_COUNT=
FLASH_TIMEOUT_SECONDS=

{
  "flashTool": {
    "commanderPath": "C:\\SiliconLabs\\SimplicityStudio\\v5\\developer\\adapter_packs\\commander\\commander.exe",
    "timeoutSeconds": 120,
    "flashRetryCount": 3,
    "useDeviceArgument": true,
    "probeCommand": [
      "{commander}",
      "adapter",
      "probe",
      "--ip",
      "{ip}"
    ],
    "flashCommand": [
      "{commander}",
      "flash",
      "{binary}",
      "--ip",
      "{ip}",
      "--device",
      "{chip_type}"
    ],
    "resetCommand": [
      "{commander}",
      "device",
      "reset",
      "--ip",
      "{ip}",
      "--device",
      "{chip_type}"
    ]
  },

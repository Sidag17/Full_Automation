# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (local)
MONGODB_URI=mongodb://127.0.0.1:27017/ml_automation

# Local workspace owned by the Node worker (not the browser)
WORKSPACE_ROOT=C:\AutomationWorkspace

# Optional override for Simplicity Commander (else use Mongo settings / defaults JSON)
COMMANDER_PATH=C:\SiliconLabs\SimplicityStudio\v5\developer\adapter_packs\commander\commander.exe

# CORS for local React Vite/CRA
CORS_ORIGIN=http://localhost:5173

# Default VCOM capture (seconds) if not set per-run
DEFAULT_CAPTURE_TIMEOUT_SECONDS=30

# Flash behavior overrides (optional; prefer Mongo SystemSettings)
FLASH_RETRY_COUNT=3
FLASH_TIMEOUT_SECONDS=120

# Artifactory (SDK prepare) — use token OR user/password
ARTIFACTORY_TOKEN=
# ARTIFACTORY_API_KEY=
# ARTIFACTORY_USER=
# ARTIFACTORY_PASSWORD=
